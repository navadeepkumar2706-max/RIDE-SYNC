# RideSync Environment Configuration Template
# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.

# ── Server-side variables (Express backend only) ──────────────────────────────
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ridesync?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# ── Client-side variables (baked into the Vite/React build) ──────────────────
# Leave empty in local development — the Vite dev-server proxy handles /api.
# In production (GitHub Pages), set this to your Express backend's base URL:
#   https://your-api.onrender.com/api
#
# Set as a GitHub Actions secret named VITE_API_URL (Settings → Secrets → Actions).
VITE_API_URL=
